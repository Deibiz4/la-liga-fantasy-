[Unit]
Description=LaLiga Fantasy Telegram Bot & Notifications Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fantasybot
ExecStart=/usr/bin/python3 -u -m fantasybot telegram
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
